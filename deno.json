{
  "version": "1.0.0",

  "tasks": {
    "test":          "deno test --env-file=.env --allow-env --allow-net",
    "test:watch":    "deno test --allow-env --allow-net --watch",
    "test:coverage": "deno test --allow-env --allow-net --coverage=coverage",
    "coverage:report": "deno coverage coverage"
  },

  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },

  "test": {
    "include": [
        "public/tests/**/*_test.js"
    ]
  },

  "lint": {
    "include": ["public/"],
    "rules": {
      "tags": ["recommended"]
    }
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "include": ["src/"]
  }
}